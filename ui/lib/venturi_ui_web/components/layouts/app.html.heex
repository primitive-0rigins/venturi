<header class="px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between border-b border-zinc-100 py-3 text-sm">
    <div class="flex items-center gap-4">
      <a href="/" class="text-brand font-bold text-lg tracking-tight">
        Venturi
      </a>
      <span class="text-accent font-medium leading-6">Operator</span>
    </div>
    <div class="flex items-center gap-4 font-semibold leading-6 text-zinc-900">
      <a href={~p"/"} class="hover:text-brand">Health</a>
      <a href={~p"/audit"} class="hover:text-brand">Audit</a>
      <a href={~p"/chains"} class="hover:text-brand">Chains</a>
      <a href={~p"/holds"} class="hover:text-brand">Legal Hold</a>
    </div>
  </div>
</header>
<main class="px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-4xl">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>
